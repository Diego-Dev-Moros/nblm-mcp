# Auth profile to bind, as created by `nblm-mcp-login --profile <name>`.
# Empty = the active/default profile under ~/.notebooklm/
NOTEBOOKLM_PROFILE=

# Explicit path to a Playwright storage_state.json holding the Google session
# cookies. Overrides NOTEBOOKLM_PROFILE. Empty = resolve from the profile.
NOTEBOOKLM_STORAGE_PATH=

# Where download_artifact writes files when given a bare filename.
# Default: ~/.nblm-mcp/downloads
NBLM_DOWNLOAD_DIR=

# Seconds to wait for a Studio artifact (podcast, report, quiz...) when
# generate_artifact is called with wait=true. Default: 600
NBLM_GENERATION_TIMEOUT=

# Seconds to wait for a newly added source to finish processing. Default: 180
NBLM_SOURCE_TIMEOUT=
